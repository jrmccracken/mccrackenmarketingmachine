# Marketing Control Centre: environment variables.
# Set these in Netlify (Site configuration > Environment variables). Never commit real values.
# For local development copy this file to .env.local (git-ignored).

# Supabase project (Project settings > API)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-side only. Bypasses row level security: never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Resend (resend.com > API keys). The from address must be on a verified domain.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# The administrator. Only this address gets the administrator view and alerts.
ADMIN_EMAIL=james@mccrackenmarketing.co.uk

# The portal's own address, with no trailing slash, e.g. https://portal.mccrackenmarketing.co.uk
SITE_URL=

# Optional. "capture" keeps emails in memory instead of sending (local development and tests only).
# Leave unset in production.
EMAIL_MODE=
