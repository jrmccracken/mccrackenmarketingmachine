# Copy to .env. Every setting can also be entered in the app (Settings / Integrations);
# environment variables win when both are set. Names are the setting key upper-cased with dots -> underscores.

PORT=3001
# MMM_PASSWORD=choose-a-password        # turns on basic auth for the whole app (recommended when deployed)
# MMM_DEMO=0                            # start with an empty workspace instead of demo data
# MMM_DB_PATH=C:\path\to\mmm.db      # default: <home folder>\Marketing Machine data\mmm.db

# AI strategist (Claude)
ANTHROPIC_API_KEY=

# Outbound email analytics (Instantly API v2)
INSTANTLY_API_KEY=

# Google: one service account for GA4 + Search Console (paste JSON, or base64 of it)
GOOGLE_SERVICE_ACCOUNT_JSON=
GA4_PROPERTY_ID=
GSC_SITE_URL=

# Google Ads
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
# GOOGLE_ADS_API_VERSION=v22

# ChatGPT ads (any JSON reporting endpoint, or use CSV import)
OPENAI_ADS_REPORT_URL=
OPENAI_ADS_API_KEY=

# LinkedIn company page
LINKEDIN_ORGANIZATION_ID=
LINKEDIN_ACCESS_TOKEN=

# Facebook + Instagram
META_PAGE_ID=
META_IG_USER_ID=
META_ACCESS_TOKEN=

# Sending (outreach)
SENDER_NAME=
SENDER_EMAIL=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
